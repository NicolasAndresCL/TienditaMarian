# ============================================================
# Monorepo TienditaMarian — .gitignore raíz (backend Python + frontend Node)
# ============================================================

# --- Secretos y entornos (NUNCA se versionan) ---
.env
.env.*
!.env.example
!**/.env.example

# --- Python / Django (backend/) ---
env/
venv/
__pycache__/
*.py[cod]
*.sqlite3
db.sqlite3
*/migrations/__pycache__/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
backend/staticfiles/
# Media subida en runtime NO se versiona...
backend/media/*
!backend/media/productos/
backend/media/productos/*
# ...salvo el catálogo de demostración, para que un clon muestre productos con imagen
!backend/media/productos/images/

# --- Node / Vite (frontend/) ---
node_modules/
dist/
dist-ssr/
frontend/coverage/
*.local

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- Bitácora personal de portafolio (no versionada) ---
memory.md
CLAUDE.md
# Registro local de trabajo abierto: nombra rutas y debilidades del entorno.
pendientes.md
# Chuleta de arranque local (rutas y puertos de esta máquina).
levanta-facil.md

# --- Artefactos de QA con navegador (Playwright MCP) ---
.playwright-mcp/

# --- Sistema / editores ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.cache
*.suo
*.sw?

# skill de estándares personal (se gestiona en ~/.claude/skills, no en el repo)
skill.md
