# Copiar a `.env`. Todo lo que empieza por VITE_ queda EMBEBIDO en el bundle y es
# público: aquí nunca va un secreto.
#
# Se lee en TIEMPO DE BUILD (`npm run build`), no en runtime: al dockerizar se
# pasa como build arg (ver frontend/Dockerfile y docker-compose.yml de la raíz).
# En producción apunta al dominio público de la API, p. ej.
#   VITE_API_BASE_URL=https://api.tienditademarian.com
VITE_API_BASE_URL=http://localhost:8000
