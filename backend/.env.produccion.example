# Variables de PRODUCCIÓN — plantilla.
#
# No se copia a un archivo: en un despliegue real estas variables se cargan en el
# panel del proveedor (Render, Fly, Railway) o con `fly secrets set`. Un `.env` en
# el servidor es un archivo más que puede filtrarse en un backup o en un log.
#
# La lista de abajo es EXHAUSTIVA: si falta una de las obligatorias, el contenedor
# no arranca (y eso es a propósito — es mejor que arrancar mal en silencio).
#
# Antes de dar por bueno un despliegue:
#     bash scripts/humo-produccion.sh
# comprueba que esta configuración arranca y se comporta bien tras un proxy TLS.

# ─────────────────────────────────────────────────────── obligatorias

DJANGO_SETTINGS_MODULE=config.settings.prod

# Generar una NUEVA, distinta de la de desarrollo:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ⚠️ Si se carga vía un .env leído por docker compose, no puede llevar `$` sin
# escapar: Compose lo interpola y la clave llega truncada, sin más aviso que un
# warning discreto.
SECRET_KEY=

# `prod.py` la lee SIN default, a propósito: faltar tiene que ser un fallo
# explícito y no un `*` silencioso que acepte cualquier Host.
ALLOWED_HOSTS=tienditademarian.cl,www.tienditademarian.cl

DATABASE_URL=postgres://usuario:password@host:5432/tiendita_marian

# ───────────────────────────────────────────────────────── HTTPS y CSRF

# Activa redirección a https, HSTS de un año y cookies `Secure`. Se deja en True
# salvo que todavía no haya TLS delante (entonces la redirección haría bucle).
SECURE_HTTPS=True

# Desde que la sesión viaja en cookies, Django RECHAZA toda escritura cuyo
# `Origin` no esté en esta lista. Con el esquema, y sin barra final.
# Si el frontend vive en otro dominio (Vercel), va el suyo, no el de la API.
CSRF_TRUSTED_ORIGINS=https://tienditademarian.cl,https://www.tienditademarian.cl

# El origen del frontend. Si no coincide, el navegador bloquea cada llamada a la
# API y la tienda se ve vacía sin ningún error visible en el servidor.
CORS_ALLOWED_ORIGINS=https://tienditademarian.cl,https://www.tienditademarian.cl

# ─────────────────────────────────────────────────────────────── media

# En False, y no es opcional: `django.views.static.serve` es síncrono y no está
# pensado para tráfico. En producción las fotos las sirve un CDN o un bucket.
#
# ⚠️ PENDIENTE ANTES DE ABRIR LA TIENDA: en Render y Fly el disco es EFÍMERO. Las
# fotos que suba Marian desde el admin desaparecen en el siguiente despliegue.
# Hace falta almacenamiento externo (S3, Cloudflare R2, Backblaze B2) vía
# `django-storages`, o un volumen persistente del proveedor. Ver docs/despliegue.md.
SERVE_MEDIA=False

# ────────────────────────────────────────────────────────────── correo

# `prod.py` usa SMTP por defecto. Django 6.1 rechaza con `mail.E001` cualquier
# backend de desarrollo si DEBUG=False, así que esto no se puede "olvidar".
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# El dominio del remitente tiene que estar verificado (SPF/DKIM) en el proveedor,
# o los correos de confirmación caen en spam.
DEFAULT_FROM_EMAIL=no-reply@tienditademarian.cl
CONTACTO_EMAIL=contacto@tienditademarian.cl

# ───────────────────────────────────────────────────────────── Webpay

# Sin estas tres, la tienda funciona pero cobra contra el ambiente de INTEGRACIÓN
# de Transbank: el flujo completo se recorre y no se mueve un peso de verdad.
# Requiere contrato de comercio con Transbank — es un trámite con sus plazos.
WEBPAY_PRODUCCION=True
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=

# A dónde vuelve la clienta desde Transbank. Es una URL del BACKEND (la vuelta es
# un POST y hay que confirmar la transacción antes de mostrar nada), y del
# FRONTEND para la redirección posterior. Tienen que ser públicas y con https:
# Transbank llama desde internet, no desde la red del despliegue.
WEBPAY_URL_RETORNO=https://api.tienditademarian.cl/api/v1/pagos/webpay/retorno/
WEBPAY_URL_FRONTEND=https://tienditademarian.cl

# ───────────────────────────────────────────────────────────── extras

LOG_LEVEL=INFO
